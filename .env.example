# ====================================================================
# LabCadence - Application Environment Configuration
# ====================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/labcadence

# Principal Investigator Notification Email (Fallback alert recipient)
PI_EMAIL=pi@example.edu

# SMTP Email Dispatch Configuration (Gmail, Office365, or Institutional SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=your_app_password_here
SMTP_FROM="LabCadence Alert" <notifications@example.com>

# Application Base URL
APP_URL=http://localhost:3000

# Optional Google Gemini API Key for Executive AI Chatbot & Progress Summaries
GEMINI_API_KEY=your_gemini_api_key_here
